<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para instalar sola la versión nueva (la actualización es obligatoria). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Para pedir quedar fuera de la optimización de batería: ver
         MainActivity.pedirBateriaSinLimite. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Se pide APARTE y después de las dos de arriba: Android obliga a que
         el usuario ya haya concedido la ubicación en primer plano, y la de
         segundo plano sólo se otorga desde la pantalla de ajustes. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Desde Android 13 la notificación del servicio necesita permiso. Sin
         ella no hay servicio en primer plano, y sin servicio en primer plano
         Android mata el seguimiento. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- La sección de Salud (permisos, GPS, batería). La abre el link
             scrappy://salud de la página, que intercepta MainActivity. -->
        <activity
            android:name=".SaludActivity"
            android:exported="false"
            android:label="Salud del teléfono" />

        <service
            android:name=".UbicacionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".ArranqueReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Al ACTUALIZAR la app Android mata el servicio y no lo
                     vuelve a levantar hasta que se abre la app: con las
                     actualizaciones obligatorias, cada versión nueva cortaba el
                     seguimiento de todos (medido el 2026-09-27). Android deja
                     arrancar un servicio en primer plano desde este aviso. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
